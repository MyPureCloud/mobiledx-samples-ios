platform :ios, "15.0"
install! 'cocoapods',
         :disable_input_output_paths => true,
         :deterministic_uuids => false
#inhibit_all_warnings!
use_frameworks! :linkage => :static

DX_UI="../../mobiledx-ios-sdk-ui/GenesysCloud-Dev.podspec"

source 'git@bitbucket.org:inindca/gc-sdk-specs-dev.git'
source 'https://cdn.cocoapods.org/'

tracking_version = File.read('../../TRACKING_VERSION.txt').strip

target 'GCMessengerSDKSample' do
    pod 'FirebaseCrashlytics'
    pod 'FirebaseMessaging'

    pod 'GenesysCloud', :path => DX_UI, :testspecs => ['UnitTests', 'ObjcUnitTests']
    pod 'GenesysCloudMobileUserTracking', tracking_version

end

post_install do |pi|
    pi.pods_project.targets.each do |t|
      t.build_configurations.each do |config|
        config.build_settings['ONLY_ACTIVE_ARCH'] = 'NO'
        config.build_settings['BUILD_LIBRARY_FOR_DISTRIBUTION'] = 'YES'
        config.build_settings["DEVELOPMENT_TEAM"] = "9U57N843V9"
	config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.0'
      end
    end
end
