be in one of the following states, represented by the "},{"type":"codeVoice","code":"ChatState"},{"type":"text","text":" enum (raw values in parentheses):"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatCreated (1)"},{"type":"text","text":": The chat session has been created but not started."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"chatStarted (2)"},{"type":"text","text":": The chat session has started."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"chatPreparing (3)","type":"codeVoice"},{"type":"text","text":": The chat is preparing socket connection."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"chatPrepared (4)","type":"codeVoice"},{"text":": The chat has been prepared, configuration fetched and is ready.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"chatDisconnected (5)","type":"codeVoice"},{"text":": The chat has been disconnected in case of an error.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatReconnecting (6)"},{"text":": The chat is attempting to reconnect.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"chatReconnected (7)"},{"type":"text","text":": The chat has successfully reconnected."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"chatEnding (8)","type":"codeVoice"},{"text":": The chat is in the process of ending.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"chatEnded (9)","type":"codeVoice"},{"text":": The chat session has ended.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatClosed (10)"},{"type":"text","text":": The chat has closed."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"unavailable (18)","type":"codeVoice"},{"type":"text","text":": The chat is unavailable."}]}]}],"type":"unorderedList"},{"text":"Usage","level":2,"anchor":"Usage","type":"heading"},{"inlineContent":[{"text":"Implement this method in the delegate to respond to changes in the chat’s lifecycle.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Common use cases include updating the UI, logging chat state transitions, or performing"},{"type":"text","text":" "},{"type":"text","text":"actions based on specific states."}],"type":"paragraph"},{"text":"Swift","level":3,"anchor":"Swift","type":"heading"},{"code":["func didUpdateState(_ event: ChatStateEvent) {","    switch event.state {","    case .chatStarted:","        \/\/ handle chat started","    case .chatEnded:","        \/\/ handle chat ended","    default:","        \/\/ handle other states","    }","}"],"syntax":"swift","type":"codeListing"}]}],"kind":"symbol","abstract":[{"type":"text","text":"Notifies the delegate of a change in the chat’s state."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"symbolKind":"method","externalID":"c:@M@GenesysCloud@objc(pl)ChatControllerDelegate(im)didUpdateState:","roleHeading":"Instance Method","title":"didUpdateState(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"didUpdateState","kind":"identifier"},{"text":"(","kind":"text"},{"text":"ChatStateEvent","kind":"typeIdentifier","preciseIdentifier":"c:@M@GenesysCloudCore@objc(cs)ChatStateEvent"},{"text":")","kind":"text"}],"role":"symbol","modules":[{"name":"GenesysCloud"}]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/genesyscloud\/chatcontrollerdelegate\/didupdatestate(_:)"]}],"references":{"doc://com.genesys.cloud.ui/documentation/GenesysCloud":{"kind":"symbol","url":"\/documentation\/genesyscloud","type":"topic","identifier":"doc:\/\/com.genesys.cloud.ui\/documentation\/GenesysCloud","title":"GenesysCloud","abstract":[],"role":"collection"},"doc://com.genesys.cloud.ui/documentation/GenesysCloud/ChatContro