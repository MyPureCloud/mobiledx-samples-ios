at is attempting to reconnect.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatReconnected (7)"},{"type":"text","text":": The chat has successfully reconnected."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatEnding (8)"},{"text":": The chat is in the process of ending.","type":"text"}]}]},{"content":[{"inlineContent":[{"code":"chatEnded (9)","type":"codeVoice"},{"type":"text","text":": The chat session has ended."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatClosed (10)"},{"type":"text","text":": The chat has closed."}]}]},{"content":[{"inlineContent":[{"code":"unavailable (18)","type":"codeVoice"},{"text":": The chat is unavailable.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Usage","text":"Usage"},{"type":"paragraph","inlineContent":[{"text":"Implement this method in the delegate to respond to changes in the chat’s lifecycle.","type":"text"},{"type":"text","text":" "},{"type":"text","text":"Common use cases include updating the UI, logging chat state transitions, or performing"},{"type":"text","text":" "},{"type":"text","text":"actions based on specific states."}]},{"type":"heading","level":3,"anchor":"Swift","text":"Swift"},{"type":"codeListing","code":["func didUpdateState(_ event: ChatStateEvent) {","    switch event.state {","    case .chatStarted:","        \/\/ handle chat started","    case .chatEnded:","        \/\/ handle chat ended","    default:","        \/\/ handle other states","    }","}"],"syntax":"swift"}],"kind":"content"}],"references":{"doc://com.genesys.cloud.ui/documentation/GenesysCloud":{"title":"GenesysCloud","identifier":"doc:\/\/com.genesys.cloud.ui\/documentation\/GenesysCloud","role":"collection","url":"\/documentation\/genesyscloud","abstract":[{"type":"text","text":"Add a native, fully featured mobile messenger solution to your iOS app, powered by G