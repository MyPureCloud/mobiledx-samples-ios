"type":"text"}],"type":"paragraph"}]}]},{"content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This delegate is triggered when there is a change in the chat state. The host application can monitor and respond to state changes, such as when a chat starts, disconnects, or ends.","type":"text"}],"type":"paragraph"},{"level":2,"text":"Chat States","anchor":"Chat-States","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The chat can be in one of the following states, represented by the "},{"code":"ChatState","type":"codeVoice"},{"type":"text","text":" enum (raw values in parentheses):"}]},{"items":[{"content":[{"inlineContent":[{"code":"chatCreated (1)","type":"codeVoice"},{"text":": The chat session has been created but not started.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"chatStarted (2)","type":"codeVoice"},{"text":": The chat session has started.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"chatPreparing (3)","type":"codeVoice"},{"text":": The chat is preparing socket connection.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"chatPrepared (4)","type":"codeVoice"},{"text":": The chat has been prepared, configuration fetched and is ready.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"chatDisconnected (5)","type":"codeVoice"},{"type":"text","text":": The chat has been disconnected in case of an error."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"chatReconnecting (6)"},{"text":": The chat is attempting to reconnect.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"chatReconnected (7)","type":"codeVoice"},{"text":": The chat has successfully reconnected.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"chatEnding (8)","type":"codeVoice"},{"type":"text","text":": The chat is in the process of ending."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"chatEnded (9)"},{"text":": The chat session has ended.","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"chatClosed (10)"},{"text":": The chat has closed.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"unavailable (18)"},{"type":"text","text":": The chat is unavailable."}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"text":"Usage","anchor":"Usage","type":"heading"},{"inlineContent":[{"text":"Implement this method in the delegate to respond to changes in the chat’s lifecycle.","type":"text"},{"text":" ","type":"text"},{"text":"Common use cases include updating the UI, logging chat state transitions, or performing","type":"text"},{"text":" ","type":"text"},{"text":"actions based on specific states.","type":"text"}],"type":"paragraph"},{"level":3,"text":"Swift","anchor":"Swift","type":"heading"},{"syntax":"swift","code":["func didUpdateState(_ event: ChatStateEvent) {","    switch event.state {","    case .chatStarted:","        \/\/ handle chat started","    case .chatEnded:","        \/\/ handle chat ended","    default:","        \/\/ handle other states","    }","}"],"type":"codeListing"}],"kind":"content"}],"schemaVersion":{"patch":0,"major":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/com.genesys.cloud.ui\/documentation\/GenesysCloud\/ChatControllerDelegate\/didUpdateState(_:)"},"sections":[],"abstract":[{"text":"Notifies the delegate of a change in the chat’s state.","type":"text"}],"references":{"genesys-logo.svg":{"alt":null,"identifier":"genesys-logo.svg","variants":[{"traits":["1x","light"],"url":"\/images\/com.genesys.cloud.ui\/genesys-logo.svg"}],"type":"image"},"doc://com.genesys.cloud.ui/documentation/GenesysCloud/ChatStateEvent":{"type":"topic","navigatorTitle":[{"kind":"identifier","text":"ChatStateEven